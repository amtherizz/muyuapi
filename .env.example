# Application Settings
APP_NAME=MUYU API
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# Base Public URL (digunakan untuk generate audio proxy stream URL jika diperlukan)
BASE_URL=https://muyu.tams.my.id

# Cache Settings (in seconds)
# 86400 seconds = 24 hours
PLAYLIST_CACHE_TTL=86400
# 14400 seconds = 4 hours
STREAM_CACHE_TTL=14400

# SQLite Cache File
CACHE_DB_PATH=cache.db

# Optional YouTube Proxy (contoh: socks5://127.0.0.1:1080 atau http://user:pass@host:port)
YTDLP_PROXY=

